{
  "mcpServers": {
    "XcodeBuildMCP": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "xcodebuildmcp@latest",
        "mcp"
      ],
      "env": {}
    },
    "apple-docs": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "apple-doc-mcp-server@latest"
      ],
      "env": {}
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    },
    "semgrep": {
      "type": "stdio",
      "command": "/Users/developer/.local/bin/uvx",
      "args": [
        "semgrep-mcp",
        "--semgrep-path",
        "/Users/developer/.local/share/uv/tools/semgrep/bin/semgrep"
      ],
      "env": {}
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=ptngtgnpfyvtiwbyxsqx&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    }
  }
}